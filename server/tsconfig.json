{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es2017",
    "noImplicitAny": true,
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "*": ["node_modules/*", "src/types/*"],
    },
  },
  "include": [
    "src/**/*",
    "__tests__/**/*",
    "../shared/src/**/*"
  ],
  "ts-node": {
      "transpileOnly": true,
      "files": true,
      "require": ["tsconfig-paths/register"]
  },
}
